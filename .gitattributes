# Normalize line endings to LF in the repository
* text=auto eol=lf

# Explicitly declare text files
*.cs text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.config text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.md text eol=lf
*.http text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Binary files
*.dll binary
*.exe binary
*.pdb binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.snk binary
*.pfx binary
